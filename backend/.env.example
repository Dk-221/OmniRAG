# ============================================================
# Agentic RAG – Environment Variables
# Copy this file to .env and fill in your values.
# ONLY GROQ_API_KEY is required.
# ============================================================

# ── Required ──────────────────────────────────────────────────
# Get a FREE key at https://console.groq.com (no credit card)
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: LLM model selection ────────────────────────────
# Both are FREE on Groq's free tier.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# ── Optional: Storage paths (relative to backend/) ───────────
# CHROMA_PATH=data/chroma_store
# KNOWLEDGE_BASE_PATH=data/knowledge_base
# DATASETS_PATH=data/datasets

# ── Optional: Server settings ─────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# LOG_LEVEL=INFO

# ── Optional: Agent tuning ─────────────────────────────────────
# MAX_AGENT_ITERATIONS=4
# MAX_HISTORY_MESSAGES=6
VERIFY_ANSWERS=true
ROUTER_MAX_TOOLS=6
